# ========================================
# BUS EKA BACKEND
# ========================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Colombo

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/bus_eka?schema=public"

# JWT - CHANGE THIS
JWT_SECRET="replace-with-a-long-random-secret"

# CORS - comma separated if you have multiple frontends
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,https://bus-eka-frontend.vercel.app"
RATE_LIMIT_MAX=300

# ========================================
# PAYHERE
# ========================================
PAYHERE_MERCHANT_ID="1220000"
PAYHERE_SECRET="456789"
PAYHERE_CURRENCY="LKR"
PAYHERE_RETURN_URL="http://localhost:3000/dashboard/passenger/booking/success"
PAYHERE_CANCEL_URL="http://localhost:3000/dashboard/passenger/booking"
PAYHERE_NOTIFY_URL="http://localhost:5000/api/payment/notify"
